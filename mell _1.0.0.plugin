def is_animal(word: str) -> bool:
    return word.lower() in ANIMALS


def looks_like_verb(word: str) -> bool:
    w = word.lower()
    return any(w.endswith(end) for end in VERB_ENDINGS)


def looks_like_adjective(word: str) -> bool:
    w = word.lower()
    return any(w.endswith(end) for end in ADJ_ENDINGS)


def add_ost(word: str) -> str:
    w = word.lower()
    if w.endswith(("сть", "есть", "ость")):
        return word

    if w.endswith(("а", "я", "о", "е", "и", "ы", "у", "ю")):
        return word + "сть"
    else:
        return word + "ость"


def transform_word(word: str) -> str:
    original = word
    lower = word.lower()

    if lower in PROTECTED:
        return original

    if lower in WORD_REPLACEMENTS:
        replacement = WORD_REPLACEMENTS[lower]
        if word[0].isupper():
            replacement = replacement[0].upper() + replacement[1:]
        return replacement

    if is_animal(lower) or any(a in lower for a in ANIMALS):
        if lower.startswith("кот"):
            return "котость булмардот" if not word[0].isupper() else "котость булмардот"
        if "птич" in lower:
            return "бурмалдички" if not word[0].isupper() else "бурмалдички"
        return word + " булмалда"

    if len(lower) <= 2 or lower in STOP_WORDS:
        return original

    if looks_like_verb(lower):
        return original

    if looks_like_adjective(lower):
        return original

    return add_ost(word)


def murino_translate(text: str) -> str:
    def replace_match(match):
        return transform_word(match.group(0))

    return re.sub(r"[а-яА-ЯёЁa-zA-Z0-9\-]+", replace_match, text)


def maybe_add_mellstroy(text: str, chance: float = 0.08) -> str:
    if random.random() < chance:
        meme = random.choice(MELLSTROY_MEMES)
        return text.rstrip() + " " + meme
    return text


class MurinoLanguagePlugin(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self.log("murino Language plugin loaded")

    def create_settings(self) -> List[Any]:
        return [
            Header(text="murino Language"),
            Switch(
                key="enabled",
                text="включить перевод",
                default=True,
                subtext="автоматически переводит все исходящие сообщения",
            ),
            Switch(
                key="mellstroy_memes",
                text="мемы с меллом",
                default=True,
                subtext="в конце мем",
            ),
            Text(
                text="как работает",
                subtext="друг → друн",
                icon="msg_info",
            ),
            Text(
                text="пример",
                subtext="ч нашел паукость в село молочное",
                icon="msg_text",
            ),
        ]

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        if not self.get_setting("enabled", True):
            return HookResult()

        if not isinstance(getattr(params, "message", None), str):
            return HookResult()

        original = params.message
        if not original.strip():
            return HookResult()

        if original.startswith((".", "/", "!")):
            return HookResult()

     
        translated = murino_translate(original)

   
        if self.get_setting("mellstroy_memes", True):
            translated = maybe_add_mellstroy(translated)

        if translated != original:
            params.message = translated
            return HookResult(strategy=HookStrategy.MODIFY, params=params)

        return HookResult()