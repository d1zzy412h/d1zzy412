def utf16_len(s: str) -> int:
    return len(s.encode("utf-16-le")) // 2

def dp(v: int) -> int:
    return AndroidUtilities.dp(v)

def clamp(v, lo, hi):
    return max(lo, min(hi, v))

def safe_int(v, default=0):
    try:
        return int(v)
    except Exception:
        return default


class ButtonHook(MethodHook):
    TAG = "ai_btn_"

    def __init__(self, plugin):
        self.p = plugin

    def after_hooked_method(self, param):
        try:
            if not self.p.get_setting("ui_button", True):
                return
            ev = param.thisObject
            if not ev or get_private_field(ev, "recordingAudioVideo"):
                return
            if get_private_field(ev, "editingMessageObject") is not None:
                return
            layout = get_private_field(ev, "attachLayout")
            if layout is None or str(layout.getTag() or "") == self.TAG:
                return
            layout.setTag(self.TAG)
            run_on_ui_thread(lambda: self._inject(layout))
        except Exception as e:
            log(f"[AI] btn: {e}")

    def _inject(self, layout):
        try:
            ctx = layout.getContext()
            btn = ImageView(ctx)
            icon = getattr(R.drawable, "msg_bot", None) or getattr(R.drawable, "msg_bots", None)
            if icon:
                btn.setImageResource(icon)
                try:
                    btn.setColorFilter(Theme.getColor(Theme.key_chat_messagePanelIcons))
                except Exception:
                    pass
            btn.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
            size, pad = dp(48), dp(10)
            btn.setPadding(pad, pad, pad, pad)
            btn.setClickable(True)

            def on_click(v):
                try:
                    frag = get_last_fragment()
                    if not frag:
                        return
                    et = get_private_field(frag, "messageEditText")
                    if et is None:
                        et = get_private_field(frag, "chatActivityEnterView")
                        if et is not None:
                            et = get_private_field(et, "messageEditText")
                    if et is None:
                        return
                    prefix = (self.p.get_setting("prefix", ".ai") or ".ai").strip() + " "
                    current = str(et.getText()).strip()
                    if not current.startswith(prefix):
                        et.setText(prefix + current)
                        et.setSelection(et.length())
                    et.requestFocus()
                    from android.view.inputmethod import InputMethodManager
                    imm = ctx.getSystemService("input_method")
                    if imm:
                        imm.showSoftInput(et, InputMethodManager.SHOW_IMPLICIT)
                except Exception as e:
                    log(f"[AI] btn click: {e}")

            btn.setOnClickListener(OnClickListener(lambda v: run_on_ui_thread(lambda: on_click(v))))
            lp = LinearLayout.LayoutParams(size, size)
            try:
                layout.addView(btn, 0, lp)
            except Exception:
                layout.addView(btn)
        except Exception as e:
            log(f"[AI] inject: {e}")


class AIAssistantPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self.http = requests.Session()
        self._dedup_msg = None
        self._dedup_ts = 0.0
        self.last_answer = ""
        self._hook = None

    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self._install_btn()
        log("[AI] loaded ")
        run_on_ui_thread(lambda: BulletinHelper.show_success(
            "AI Assistant · .ai / .tr / .sum / .img / .gen"
        ))

    def on_plugin_unload(self):
        if self._hook:
            try:
                self.unhook_method(self._hook)
            except Exception:
                pass

    def _install_btn(self):
        try:
            cls = find_class("org.telegram.ui.Components.ChatActivityEnterView")
            if not cls:
                return
            m = cls.getClass().getDeclaredMethod("checkSendButton", jclass("java.lang.Boolean").TYPE)
            m.setAccessible(True)
            self._hook = self.hook_method(m, ButtonHook(self))
        except Exception as e:
            log(f"[AI] hook: {e}")

    # ── Навигация настроек ─────────────────────

    def _go_page(self, page: str):
        self.set_setting("_settings_page", page, reload_settings=True)

    def create_settings(self) -> List[Any]:
        page = self.get_setting("_settings_page", "main") or "main"

        if page == "main":
            return [
                Header(text="AI Assistant"),
                Text(text="Основные", subtext="Включение, API-ключ, кнопка",
                     icon="msg_bot", on_click=lambda v: self._go_page("basic")),
                Text(text="Модель и роль", subtext="Модель, роль, свой промпт",
                     icon="msg_media", on_click=lambda v: self._go_page("model")),
                Text(text="Оформление ответа", subtext="Стиль, цитата, мета",
                     icon="msg_photo_settings", on_click=lambda v: self._go_page("style")),
                Text(text="Команды", subtext="Префикс, режим без команд",
                     icon="msg_list", on_click=lambda v: self._go_page("commands")),
                Text(text="Контекст", subtext="Память диалога",
                     icon="menu_username_set", on_click=lambda v: self._go_page("context")),
                Text(text="Генерация", subtext="Температура, токены, модель картинок",
                     icon="msg_settings", on_click=lambda v: self._go_page("gen")),
                Text(text="Статистика", subtext="Токены",
                     icon="msg_stats", on_click=lambda v: self._go_page("stats")),
            ]

        if page == "basic":
            return [
