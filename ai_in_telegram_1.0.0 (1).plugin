                Text(text="← Назад", icon="msg_arrow_back", on_click=lambda v: self._go_page("main")),
                Header(text="Оформление ответа"),
                Selector(key="style", text="Стиль", default=0, items=STYLE_NAMES, icon="msg_photo_settings"),
                Switch(key="blockquote", text="Сворачиваемая цитата", default=True, icon="ic_outinline"),
                Switch(key="show_question", text="Показывать вопрос", default=True),
