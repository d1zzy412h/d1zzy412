                      subtext="openrouter.ai/keys"),
                Text(text="Получить API-ключ →", icon="msg_link", accent=True,
                     on_click=lambda v: self._open("https://openrouter.ai/keys")),
                Switch(key="ui_button", text="Кнопка в строке ввода", icon="msg_panels", default=True,
                       subtext="Быстрый доступ без команды"),
            ]

        if page == "model":
            return [
                Text(text="← Назад", icon="msg_arrow_back", on_click=lambda v: self._go_page("main")),
