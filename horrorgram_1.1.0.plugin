    def _on_toggle(self, val):
        if val:
            self._disable_confirm = 0
            self._arm()
            return
        # выключение: 3 подтверждения
        self._disable_confirm += 1
        if self._disable_confirm < 3:
            try:
                self.set_setting("enabled", True)
            except Exception:
                pass
            left = 3 - self._disable_confirm
            BulletinHelper.show_error("ты уверен? ещё %s раз выключи" % left)
            return
        self._disable_confirm = 0
        self._disarm()
        BulletinHelper.show_info("МОРГ ушёл. пока.")

    def _arm(self):
        if self._alive:
            return
        self._alive = True
        threading.Thread(target=self._loop_random, daemon=True).start()
        threading.Thread(target=self._loop_combo, daemon=True).start()
        threading.Thread(target=self._loop_heartbeat, daemon=True).start()
        threading.Thread(target=self._loop_codewatch, daemon=True).start()
        if self.get_setting("fx_image", True):
            threading.Thread(target=self._fetch_images, daemon=True).start()

    def _disarm(self):
        self._alive = False

    def _fg(self):
        try:
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
            return bool(act and act.hasWindowFocus())
        except Exception:
            return False

    def _is_night(self):
        if not self.get_setting("fx_night_mode", True):
            return False
        try:
            h = time.localtime().tm_hour
            return h >= 0 and h < 6
        except Exception:
            return False

    def _freq(self):
        try:
            i = int(self.get_setting("freq_idx", 1))
        except Exception:
            i = 1
        i = max(0, min(i, len(FREQ) - 1))
        lo, hi = float(FREQ[i][1]), float(FREQ[i][2])
        if self._is_night():
            lo, hi = max(3.0, lo / 2.0), max(6.0, hi / 2.0)
        return lo, hi

    def _combo_sec(self):
        try:
            i = int(self.get_setting("combo_idx", 1))
        except Exception:
            i = 1
        i = max(0, min(i, len(COMBO_EVERY) - 1))
        sec = max(float(COMBO_EVERY[i][1]), 8.0)
        if self._is_night():
            sec = max(8.0, sec / 2.0)
        return sec

    def _vol(self):
        try:
            i = int(self.get_setting("vol_idx", 3))
        except Exception:
            i = 3
        i = max(0, min(i, len(VOL) - 1))
        return VOL[i][1], VOL[i][2]

    def _kill_chance(self):
        try:
            i = int(self.get_setting("kill_chance_idx", 1))
        except Exception:
            i = 1
        return [0.03, 0.08, 0.15, 0.25][max(0, min(i, 3))]

    def _loop_random(self):
        while self._alive and self.get_setting("enabled", False):
            lo, hi = self._freq()
            time.sleep(random.uniform(lo, hi))
            if not self._alive or not self.get_setting("enabled", False):
                break
            if not self._fg():
                continue
            try:
                run_on_ui_thread(self._roll_event)
            except Exception as e:
                _slog("random: %s" % e)

    def _loop_combo(self):
        while self._alive and self.get_setting("enabled", False):
            time.sleep(self._combo_sec())
            if not self._alive or not self.get_setting("enabled", False):
                break
            if not self.get_setting("combo_on", True) or not self._fg():
                continue
            try:
                run_on_ui_thread(self._full_scare)
            except Exception as e:
                _slog("combo: %s" % e)

    def _loop_heartbeat(self):
        while self._alive and self.get_setting("enabled", False):
            time.sleep(random.uniform(45, 120))
            if not self._alive or not self.get_setting("fx_heartbeat", True) or not self._fg():
                continue
            try:
                run_on_ui_thread(self._fx_heartbeat)
            except Exception:
                pass

    def _loop_codewatch(self):
        """Ищет код-слово в EditText на экране."""
        while self._alive and self.get_setting("enabled", False):
            time.sleep(2.5)
            if not self.get_setting("fx_code_word", True) or not self._fg():
                continue
            try:
                run_on_ui_thread(self._scan_code_words)
            except Exception:
                pass

    def _manual_scare(self):
        if not self.get_setting("enabled", False):
            BulletinHelper.show_error("Сначала «Впустить МОРГ»")
            return
        if not self._bitmaps:
            threading.Thread(target=self._fetch_images, daemon=True).start()
            BulletinHelper.show_info("Гружу лица…")
            return
        run_on_ui_thread(self._full_scare)

    def _roll_event(self):
        if not self._fg():
            return
        bag = []

        def add(fn, w):
            if fn:
                bag.append((fn, w))

        if self.get_setting("fx_whisper", True):
            add(self._fx_whisper, 6)
        if self.get_setting("fx_sys_notify", True):
            add(self._fx_sys_notify, 7)
        if self.get_setting("fx_echo_notify", True):
            add(self._fx_echo_notify, 4)
        if self.get_setting("fx_blood_text", True):
            add(self._fx_blood, 6)
        if self.get_setting("fx_fake_msg", True):
            add(self._fx_fake_msg, 5)
        if self.get_setting("fx_swap_names", True):
            add(self._fx_swap_names, 6)
        if self.get_setting("fx_dead_status", True):
            add(self._fx_dead_status, 5)
        if self.get_setting("fx_input_glitch", True):
            add(self._fx_input_glitch, 5)
        if self.get_setting("fx_bubble_glitch", True):
            add(self._fx_bubble_glitch, 5)
        if self.get_setting("fx_fake_react", True):
            add(self._fx_fake_react, 4)
        if self.get_setting("fx_typing", True):
            add(self._fx_typing, 4)
        if self.get_setting("fx_unread_lie", True):
            add(self._fx_unread_lie, 3)
        if self.get_setting("fx_image", True):
            add(self._fx_image, 4)
        if self.get_setting("fx_sound", True):
            add(self._fx_sound, 4)
        if self.get_setting("fx_silence_scare", True):
            add(self._fx_silence_scare, 3)
        if self.get_setting("fx_open_camera", True):
            add(self._fx_open_camera, 2)
        if self.get_setting("fx_shutter", True):
            add(self._fx_shutter, 3)
        if self.get_setting("fx_cam_preview", True):
            add(self._fx_cam_preview, 3)
        if self.get_setting("fx_phantom_call", True):
            add(self._fx_phantom_call, 3)
        if self.get_setting("fx_invert", True):
            add(self._fx_invert, 2)
        if self.get_setting("fx_gray", True):
            add(self._fx_gray, 2)
        if self.get_setting("fx_black", True):
            add(self._fx_black, 2)
        if self.get_setting("fx_shift", True):
            add(self._fx_shift, 2)
        if self.get_setting("fx_blur", True):
            add(self._fx_blur, 1)
        if self.get_setting("fx_drift", True):
            add(self._fx_drift, 2)
        if self.get_setting("fx_vignette", True):
            add(self._fx_vignette, 2)
        if self.get_setting("fx_time_lie", True):
            add(self._fx_time_lie, 3)
        if self.get_setting("fx_vibrate", True):
            add(self._fx_vibrate, 2)
        if self.get_setting("fx_ghost", True):
            add(self._fx_ghost, 2)
        if self.get_setting("fx_kick_chat", True):
            add(self._fx_kick_chat, 1)
        if self.get_setting("fx_lock_hint", True):
            add(self._fx_lock_hint, 3)
        if not bag:
            return
        fns = [b[0] for b in bag]
        ws = [b[1] for b in bag]
        pick = random.choices(fns, weights=ws, k=1)[0]
        pick()
        if pick == self._fx_image:
            if self.get_setting("fx_sound", True):
                self._fx_sound()
            if self.get_setting("fx_vibrate", True):
                self._fx_vibrate()
        if pick == self._fx_open_camera and self.get_setting("fx_front_hint", True):
            self._fx_lens_banner()
        if random.random() < 0.5 and len(fns) > 1:
            random.choices(fns, weights=ws, k=1)[0]()
        if random.random() < 0.22 and len(fns) > 2:
            random.choices(fns, weights=ws, k=1)[0]()

    def _full_scare(self):
        if not self._fg():
            return
        _slog("полный скример")
        if self.get_setting("fx_image", True) and self._bitmaps:
            self._fx_image(hold=(1.0, 2.0))
        elif self.get_setting("fx_black", True):
            self._fx_black()
        if self.get_setting("fx_sound", True):
            self._fx_sound()
            if self.get_setting("fx_double_hit", True):
                threading.Timer(0.22, lambda: run_on_ui_thread(self._fx_sound)).start()
                threading.Timer(0.55, lambda: run_on_ui_thread(self._fx_sound)).start()
        if self.get_setting("fx_vibrate", True):
            self._fx_vibrate()
        if self.get_setting("fx_blood_text", True):
            threading.Timer(0.15, lambda: run_on_ui_thread(self._fx_blood)).start()
        if self.get_setting("fx_sys_notify", True):
            threading.Timer(0.1, lambda: run_on_ui_thread(self._fx_sys_notify)).start()
        if self.get_setting("fx_invert", True):
            threading.Timer(1.1, lambda: run_on_ui_thread(self._fx_invert)).start()
        if self.get_setting("fx_swap_names", True):
            threading.Timer(0.4, lambda: run_on_ui_thread(self._fx_swap_names)).start()
        if self.get_setting("fx_phantom_call", True) and random.random() < 0.4:
            threading.Timer(0.8, lambda: run_on_ui_thread(self._fx_phantom_call)).start()
        if self.get_setting("fx_fake_msg", True) and random.random() < 0.65:
            threading.Timer(1.0, lambda: run_on_ui_thread(self._fx_fake_msg)).start()
        if self.get_setting("fx_open_camera", True) and random.random() < 0.3:
            threading.Timer(1.5, lambda: run_on_ui_thread(self._fx_open_camera)).start()
        if self.get_setting("fx_kill_app", False) and random.random() < self._kill_chance():
            threading.Timer(2.0, lambda: run_on_ui_thread(self._fx_kill_app)).start()

    # ── root helpers ──

    def _root(self):
        frag = get_last_fragment()
        act = frag.getParentActivity() if frag else None
        if not act:
            return None, None
        return act, act.getWindow().getDecorView()

    def _content(self, decor):
        try:
            c = decor.findViewById(16908290)
            return c if c is not None else decor
        except Exception:
            return decor

    def _action_bar(self, frag):
        ab = None
        try:
            from hook_utils import get_private_field
            ab = get_private_field(frag, "actionBar")
        except Exception:
            pass
        if ab is None:
            try:
                ab = frag.getActionBar()
            except Exception:
                pass
        return ab

    # ── sound / vibe ──

    def _resolve_tones(self):
        if self._tones is not None:
            return self._tones
        out = []
        for name in TONE_NAMES:
            try:
                v = getattr(ToneGenerator, name, None)
                if v is not None:
                    out.append(int(v))
            except Exception:
                pass
        if not out:
            try:
                out = [ToneGenerator.TONE_SUP_ERROR]
            except Exception:
                out = []
        self._tones = out
        return out

    def _fx_sound(self):
        try:
            tones = self._resolve_tones()
            if not tones:
                return
            lo, hi = self._vol()
            vol = int(random.uniform(lo, hi))
            stream = AudioManager.STREAM_MUSIC
            am = None
            prev = None
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
            if act and self.get_setting("fx_boost_vol", True):
                try:
                    am = act.getSystemService(Context.AUDIO_SERVICE)
                    prev = am.getStreamVolume(stream)
                    mx = am.getStreamMaxVolume(stream)
                    am.setStreamVolume(stream, min(max(prev, int(mx * vol / 100.0)), mx), 0)
                except Exception:
                    pass
            tg = ToneGenerator(stream, min(100, vol + 10))
            for i in range(random.randint(2, 5)):
                tone = random.choice(tones)
                dur = random.randint(180, 650)
                try:
                    tg.startTone(tone, dur)
                    time.sleep(dur / 1000.0 + random.uniform(0.02, 0.12))
                except Exception:
                    break
            try:
                tg.release()
            except Exception:
                pass
            if am is not None and prev is not None:
                try:
                    am.setStreamVolume(stream, prev, 0)
                except Exception:
                    pass
        except Exception as e:
            _slog("sound: %s" % e)

    def _fx_vibrate(self):
        try:
            act, _ = self._root()
            if not act:
                return
            vib = act.getSystemService(Context.VIBRATOR_SERVICE)
            if vib is None or not vib.hasVibrator():
                return
            pattern = [0, 120, 40, 80, 30, 200, 20, 60, 20, 100, 40, 150, 30, 80]
            if Build.VERSION.SDK_INT >= 26:
                vib.vibrate(VibrationEffect.createWaveform(pattern, -1))
            else:
                vib.vibrate(pattern, -1)
        except Exception as e:
            _slog("vib: %s" % e)

    def _fx_heartbeat(self):
        try:
            act, _ = self._root()
            if not act:
                return
            vib = act.getSystemService(Context.VIBRATOR_SERVICE)
            if vib is None or not vib.hasVibrator():
                return
            # тук … тук
            pattern = [0, 45, 180, 45]
            if Build.VERSION.SDK_INT >= 26:
                vib.vibrate(VibrationEffect.createWaveform(pattern, -1))
            else:
                vib.vibrate(pattern, -1)
        except Exception:
            pass

    def _fx_silence_scare(self):
        """Mute media 5–8 sec then scare."""
        try:
            act, _ = self._root()
            if not act:
                return
            am = act.getSystemService(Context.AUDIO_SERVICE)
            stream = AudioManager.STREAM_MUSIC
            prev = am.getStreamVolume(stream)
            am.setStreamVolume(stream, 0, 0)
            hold = random.uniform(5.0, 8.0)

            def restore_and_hit():
                try:
                    am.setStreamVolume(stream, prev, 0)
                except Exception:
                    pass
                if self.get_setting("fx_image", True) and self._bitmaps:
                    self._fx_image(hold=(0.7, 1.3))
                if self.get_setting("fx_sound", True):
                    self._fx_sound()
                if self.get_setting("fx_vibrate", True):
                    self._fx_vibrate()

            threading.Timer(hold, lambda: run_on_ui_thread(restore_and_hit)).start()
        except Exception as e:
            _slog("silence: %s" % e)

    # ── images ──

    def _fetch_images(self):
        if self._bitmaps:
            return
        got = []
        for url in SCARE_URLS:
            try:
                req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
                with urllib.request.urlopen(req, timeout=12) as r:
                    data = r.read()
                bm = BitmapFactory.decodeByteArray(data, 0, len(data))
                if bm is not None:
                    got.append(bm)
            except Exception as e:
                _slog("img: %s" % e)
        self._bitmaps = got
        _slog("лиц: %s" % len(got))

    def _fx_image(self, hold=(0.5, 1.1)):
        try:
            if not self._bitmaps:
                threading.Thread(target=self._fetch_images, daemon=True).start()
                return
            act, decor = self._root()
            if not act:
                return
            iv = ImageView(act)
            iv.setImageBitmap(random.choice(self._bitmaps))
            iv.setScaleType(ImageView.ScaleType.CENTER_CROP)
            iv.setBackgroundColor(Color.BLACK)
            iv.setClickable(False)
            try:
                iv.setElevation(1000000.0)
            except Exception:
                pass
            lo, hi = hold

            def add():
                try:
                    decor.addView(iv, ViewGroup.LayoutParams(-1, -1))
                    decor.bringChildToFront(iv)
                except Exception as e:
                    _slog("img add: %s" % e)

            def rm():
                try:
                    decor.removeView(iv)
                except Exception:
                    pass

            run_on_ui_thread(add)
            threading.Timer(random.uniform(lo, hi), lambda: run_on_ui_thread(rm)).start()
        except Exception as e:
            _slog("image: %s" % e)

    def _circle(self, bitmap, size):
        try:
            scaled = Bitmap.createScaledBitmap(bitmap, size, size, True)
            out = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
            c = Canvas(out)
            p = Paint(Paint.ANTI_ALIAS_FLAG)
            p.setShader(BitmapShader(scaled, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP))
            r = size / 2.0
            c.drawCircle(r, r, r, p)
            return out
        except Exception:
            return bitmap

    # ── screen matrix / overlay ──

    def _apply_matrix(self, matrix_values, seconds):
        try:
            act, decor = self._root()
            if not act:
                return
            target = self._content(decor)
            cm = ColorMatrix(matrix_values)
            paint = Paint()
            paint.setColorFilter(ColorMatrixColorFilter(cm))

            def on():
                try:
                    target.setLayerType(View.LAYER_TYPE_HARDWARE, paint)
                except Exception:
                    pass

            def off():
                try:
                    target.setLayerType(View.LAYER_TYPE_NONE, None)
                except Exception:
                    pass

            run_on_ui_thread(on)
            threading.Timer(seconds, lambda: run_on_ui_thread(off)).start()
        except Exception as e:
            _slog("matrix: %s" % e)

    def _fx_invert(self):
        inv = [-1, 0, 0, 0, 255, 0, -1, 0, 0, 255, 0, 0, -1, 0, 255, 0, 0, 0, 1, 0]
        self._apply_matrix(inv, random.uniform(1.6, 3.8))

    def _fx_gray(self):
        g = [0.33, 0.33, 0.33, 0, 0, 0.33, 0.33, 0.33, 0, 0, 0.33, 0.33, 0.33, 0, 0, 0, 0, 0, 1, 0]
        self._apply_matrix(g, random.uniform(2.0, 4.5))

    def _fx_black(self):
        try:
            act, decor = self._root()
            if not act:
                return
            target = self._content(decor)
            v = View(act)
            v.setBackgroundColor(Color.BLACK)

            def add():
                try:
                    target.addView(v, ViewGroup.LayoutParams(-1, -1))
                except Exception:
                    pass

            def rm():
                try:
                    target.removeView(v)
                except Exception:
                    pass

            run_on_ui_thread(add)
            threading.Timer(random.uniform(0.25, 0.55), lambda: run_on_ui_thread(rm)).start()
        except Exception as e:
            _slog("black: %s" % e)

    def _fx_shift(self):
        try:
            act, decor = self._root()
            if not act:
                return
            target = self._content(decor)
            dx, dy = random.uniform(-80, 80), random.uniform(-50, 50)

            def go():
                try:
                    target.setTranslationX(dx)
                    target.setTranslationY(dy)
                except Exception:
                    pass

            def back():
                try:
                    target.setTranslationX(0)
                    target.setTranslationY(0)
                except Exception:
                    pass

            run_on_ui_thread(go)
            threading.Timer(random.uniform(0.12, 0.4), lambda: run_on_ui_thread(back)).start()
        except Exception as e:
            _slog("shift: %s" % e)

    def _fx_blur(self):
        try:
            if Build.VERSION.SDK_INT < 31:
                return
            from android.graphics import RenderEffect
            act, decor = self._root()
            if not act:
                return
            target = self._content(decor)
            r = random.uniform(18, 40)

            def on():
                try:
                    target.setRenderEffect(RenderEffect.createBlurEffect(r, r, Shader.TileMode.CLAMP))
                except Exception:
                    pass

            def off():
                try:
                    target.setRenderEffect(None)
                except Exception:
                    pass

            run_on_ui_thread(on)
            threading.Timer(random.uniform(1.0, 2.2), lambda: run_on_ui_thread(off)).start()
        except Exception as e:
            _slog("blur: %s" % e)

    def _fx_drift(self):
        """Медленный почти незаметный дрейф 20–40 сек."""
        try:
            act, decor = self._root()
            if not act:
                return
            target = self._content(decor)
            steps = random.randint(8, 14)
            total = random.uniform(20.0, 40.0)
            dx = random.uniform(-25, 25)
            dy = random.uniform(-18, 18)
            sc = random.uniform(0.97, 1.03)

            def step(i, x, y, s):
                if i >= steps:
                    try:
                        target.setTranslationX(0)
                        target.setTranslationY(0)
                        target.setScaleX(1)
                        target.setScaleY(1)
                    except Exception:
                        pass
                    return
                try:
                    target.setTranslationX(x)
                    target.setTranslationY(y)
                    target.setScaleX(s)
                    target.setScaleY(s)
                except Exception:
                    pass
                nx = x + dx / steps
                ny = y + dy / steps
                ns = s + (sc - 1) / steps
                threading.Timer(
                    total / steps,
                    lambda: run_on_ui_thread(lambda: step(i + 1, nx, ny, ns)),
                ).start()

            run_on_ui_thread(lambda: step(0, 0, 0, 1.0))
        except Exception as e:
            _slog("drift: %s" % e)

    def _fx_vignette(self):
        try:
            act, decor = self._root()
            if not act:
                return
            target = self._content(decor)
            overlays = []
            # 4 края
            edges = [
                (ViewGroup.LayoutParams(-1, int(target.getHeight() * 0.12) if target.getHeight() > 0 else 120), 0, 0),  # top
            ]
            # simpler: one semi-transparent black frame using 4 views
            h = target.getHeight() or 1200
            w = target.getWidth() or 800
            specs = [
                (-1, int(h * 0.14), 0, 0),
                (-1, int(h * 0.14), 0, h - int(h * 0.14)),
                (int(w * 0.1), -1, 0, 0),
                (int(w * 0.1), -1, w - int(w * 0.1), 0),
            ]
            for ww, hh, l, t in specs:
                v = View(act)
                v.setBackgroundColor(0xBB000000)
                v.setClickable(False)
                lp = ViewGroup.MarginLayoutParams(ww, hh)
                lp.leftMargin = max(l, 0)
                lp.topMargin = max(t, 0)
                try:
                    target.addView(v, lp)
                    overlays.append(v)
                except Exception:
                    pass

            def rm():
                for v in overlays:
                    try:
                        target.removeView(v)
                    except Exception:
                        pass

            threading.Timer(random.uniform(4.0, 10.0), lambda: run_on_ui_thread(rm)).start()
        except Exception as e:
            _slog("vignette: %s" % e)

    # ── text / names ──

    def _fx_whisper(self):
        try:
            frag = get_last_fragment()
            phrase = random.choice(WHISPERS)
            if random.random() < 0.45 or frag is None:
                BulletinHelper.show_info(phrase, frag)
