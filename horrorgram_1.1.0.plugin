            t1.setText(random.choice(["ЗАБЛОКИРОВАНО", "МОРГ", "НЕТ ДОСТУПА", "..."]))
            t1.setTextColor(Color.RED)
            t1.setTextSize(28)
            t2 = TextView(act)
            t2.setText(random.choice([
                "введи код, которого нет", "лицо не распознано",
                "ты не хозяин", "попытка 3/3",
            ]))
            t2.setTextColor(Color.WHITE)
            t2.setTextSize(16)
            box.addView(t1)
            box.addView(t2)

            def add():
                try:
                    target.addView(box, ViewGroup.LayoutParams(-1, -1))
                except Exception:
                    pass

            def rm():
                try:
                    target.removeView(box)
                except Exception:
                    pass

            run_on_ui_thread(add)
            threading.Timer(random.uniform(1.2, 2.8), lambda: run_on_ui_thread(rm)).start()
            if self.get_setting("fx_sound", True) and random.random() < 0.7:
                self._fx_sound()
        except Exception as e:
            _slog("lock: %s" % e)

    def _fx_kick_chat(self):
        try:
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
            if act:
                act.onBackPressed()
        except Exception as e:
            _slog("kick: %s" % e)

    def _fx_kill_app(self):
        try:
            act, _ = self._root()
            if not act:
                return
            _slog("finish")
            try:
                act.finishAffinity()
            except Exception:
                act.finish()
        except Exception as e:
            _slog("kill: %s" % e)
