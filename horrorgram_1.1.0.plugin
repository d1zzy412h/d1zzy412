            lp = ViewGroup.MarginLayoutParams(-2, -2)
            lp.leftMargin = random.randint(0, max(w - 220, 0))
            lp.topMargin = random.randint(0, max(h - 120, 0))

            def add():
                try:
                    target.addView(tv, lp)
                except Exception:
                    pass

            def rm():
