    def _fx_input_glitch(self):
        """Подменяет текст в первом найденном EditText."""
        try:
            act, decor = self._root()
            if not act:
                return
            edits = []
            self._find_edits(self._content(decor), edits, 0)
            if not edits:
                return
            et = random.choice(edits)
            old = ""
            try:
                old = str(et.getText())
            except Exception:
                pass
            horror = random.choice([
                "не пиши это", "он читает", "забудь", "МОРГ",
                "я уже здесь", "не отправляй",
            ])
            try:
                et.setText(horror)
            except Exception:
                return

            def restore():
                try:
                    et.setText(old)
                except Exception:
                    pass

            threading.Timer(random.uniform(1.5, 3.5), lambda: run_on_ui_thread(restore)).start()
        except Exception as e:
            _slog("input: %s" % e)

    def _find_edits(self, view, out, depth):
        if view is None or depth > 14 or len(out) > 8:
            return
        try:
            if isinstance(view, EditText):
                out.append(view)
        except Exception:
            pass
        try:
            if isinstance(view, ViewGroup):
                n = view.getChildCount()
                for i in range(n):
                    self._find_edits(view.getChildAt(i), out, depth + 1)
        except Exception:
            pass

    def _scan_code_words(self):
        try:
            act, decor = self._root()
            if not act:
                return
            edits = []
            self._find_edits(self._content(decor), edits, 0)
            for et in edits:
                try:
                    txt = str(et.getText()).lower().strip()
                except Exception:
                    continue
                for w in CODE_WORDS:
                    if w in txt:
                        _slog("код-слово: %s" % w)
                        try:
                            et.setText("")
                        except Exception:
                            pass
                        self._full_scare()
                        return
        except Exception:
            pass

