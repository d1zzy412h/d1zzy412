            act = frag.getParentActivity()
            if not act:
                BulletinHelper.show_info(phrase, frag)
                return
            b = AlertDialogBuilder(act)
            b.set_title(random.choice(SCARE_TITLES))
            b.set_message(phrase)
            b.set_positive_button("…", lambda d, w=None: d.dismiss())
            b.show()
        except Exception as e:
            _slog("whisper: %s" % e)

