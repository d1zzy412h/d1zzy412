def _slog(msg):
    try:
        log("[МОРГ] %s" % msg)
    except Exception:
        pass


class MorguePlugin(BasePlugin):

    def on_plugin_load(self):
        self._alive = False
        self._bitmaps = []
        self._tones = None
        self._visits = int(self.get_setting("_visits", 0) or 0) + 1
        try:
            self.set_setting("_visits", self._visits)
        except Exception:
            pass
        self._disable_confirm = 0
        _slog("визит #%s" % self._visits)
        if self.get_setting("enabled", False):
            self._arm()
            if self.get_setting("fx_visit_count", True) and self._visits % 3 == 0:
                run_on_ui_thread(lambda: BulletinHelper.show_error(
                    "ты открывал МОРГ %s раз. хватит." % self._visits
                ))

    def on_plugin_unload(self):
        self._disarm()

    # ── settings ──

