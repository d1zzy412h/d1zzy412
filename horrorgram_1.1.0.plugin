    def _fx_lens_banner(self):
        try:
            act, decor = self._root()
            if not act:
                return
            target = self._content(decor)
            tv = TextView(act)
            tv.setText(random.choice([
                "СМОТРИ В ОБЪЕКТИВ", "Я ВИЖУ ТЕБЯ", "НЕ ОТВОРАЧИВАЙСЯ",
                "ЗАПИСЬ ИДЁТ", "УЛЫБНИСЬ",
            ]))
            tv.setTextColor(Color.RED)
            tv.setTextSize(random.uniform(26, 40))
            try:
                tv.setTypeface(Typeface.DEFAULT_BOLD)
            except Exception:
                pass
            tv.setGravity(17)
            tv.setClickable(False)

            def add():
                try:
                    target.addView(tv, ViewGroup.LayoutParams(-1, -2))
                except Exception:
                    pass

            def rm():
                try:
                    target.removeView(tv)
                except Exception:
                    pass

            run_on_ui_thread(add)
            threading.Timer(random.uniform(1.5, 3.5), lambda: run_on_ui_thread(rm)).start()
        except Exception as e:
            _slog("lens: %s" % e)

    def _fx_phantom_call(self):
        """Оверлей входящего звонка."""
        try:
            act, decor = self._root()
            if not act:
                return
            target = self._content(decor)
            root = LinearLayout(act)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setBackgroundColor(0xF0101010)
            root.setPadding(40, 120, 40, 80)
            root.setClickable(True)
            name = TextView(act)
            name.setText(random.choice(["Unknown", "МОРГ", "Неизвестный", "000-000", "я"]))
            name.setTextColor(Color.WHITE)
            name.setTextSize(28)
            name.setGravity(17)
            sub = TextView(act)
            sub.setText(random.choice(["входящий…", "шифрованный звонок", "не сбрасывай"]))
            sub.setTextColor(0xFFAAAAAA)
            sub.setTextSize(16)
            sub.setGravity(17)
            btn = TextView(act)
            btn.setText("  сбросить  ")
            btn.setTextColor(Color.WHITE)
            btn.setTextSize(18)
            btn.setPadding(40, 24, 40, 24)
            gd = GradientDrawable()
            gd.setColor(0xFFCC2222)
            gd.setCornerRadius(40)
            btn.setBackground(gd)
            btn.setGravity(17)
            root.addView(name)
            root.addView(sub)
            spacer = View(act)
            root.addView(spacer, LinearLayout.LayoutParams(-1, 80))
            root.addView(btn)

            def add():
                try:
                    target.addView(root, ViewGroup.LayoutParams(-1, -1))
                except Exception:
                    pass

            def rm():
                try:
                    target.removeView(root)
                except Exception:
                    pass

            from java import dynamic_proxy

            class Click(dynamic_proxy(View.OnClickListener)):
                def onClick(self, v):
                    rm()

            btn.setOnClickListener(Click())
            run_on_ui_thread(add)
            if self.get_setting("fx_sound", True):
                self._fx_sound()
            threading.Timer(random.uniform(6.0, 12.0), lambda: run_on_ui_thread(rm)).start()
        except Exception as e:
            _slog("call: %s" % e)

    def _fx_lock_hint(self):
        try:
            act, decor = self._root()
            if not act:
                return
            target = self._content(decor)
            box = LinearLayout(act)
            box.setOrientation(LinearLayout.VERTICAL)
            box.setBackgroundColor(Color.BLACK)
            box.setPadding(40, 80, 40, 80)
            box.setClickable(True)
