    def _fx_ghost(self):
        try:
            act, decor = self._root()
            if not act:
                return
            target = self._content(decor)
            w, h = target.getWidth(), target.getHeight()
            if w <= 0 or h <= 0:
                return
            size = random.randint(50, 90)
            dot = View(act)
            dot.setClickable(False)
            gd = GradientDrawable()
            gd.setShape(GradientDrawable.OVAL)
            gd.setColor(0x66FF0000 if random.random() < 0.4 else 0x55FFFFFF)
            dot.setBackground(gd)
            lp = ViewGroup.MarginLayoutParams(size, size)
            lp.leftMargin = random.randint(0, max(w - size, 0))
            lp.topMargin = random.randint(0, max(h - size, 0))

            def add():
                try:
                    target.addView(dot, lp)
                except Exception:
                    pass

            def rm():
                try:
                    target.removeView(dot)
                except Exception:
                    pass

            run_on_ui_thread(add)
            threading.Timer(random.uniform(0.2, 0.55), lambda: run_on_ui_thread(rm)).start()
        except Exception as e:
            _slog("ghost: %s" % e)

    def _fx_fake_msg(self):
        try:
            act, decor = self._root()
            if not act:
                return
            target = self._content(decor)
            w, h = target.getWidth(), target.getHeight()
            if w <= 0 or h <= 0:
                return
            av_size = 86
            av = ImageView(act)
            av.setClickable(False)
            if self._bitmaps:
                av.setImageBitmap(self._circle(random.choice(self._bitmaps), av_size))
            else:
                gd = GradientDrawable()
                gd.setShape(GradientDrawable.OVAL)
                gd.setColor(Color.BLACK)
                av.setBackground(gd)
            name = TextView(act)
            name.setText(random.choice(FAKE_NAMES))
            name.setTextColor(Color.RED)
            name.setTextSize(13)
            msg = TextView(act)
            msg.setText(random.choice(FAKE_BUBBLES))
            msg.setTextColor(Color.WHITE)
            msg.setTextSize(15)
            col = LinearLayout(act)
            col.setOrientation(LinearLayout.VERTICAL)
            col.addView(name)
            col.addView(msg)
            bubble = LinearLayout(act)
            bubble.setOrientation(LinearLayout.HORIZONTAL)
            bubble.setPadding(22, 18, 22, 18)
            bg = GradientDrawable()
            bg.setColor(-300279270)
            bg.setCornerRadius(28)
            bubble.setBackground(bg)
            alp = LinearLayout.LayoutParams(av_size, av_size)
            alp.rightMargin = 16
            bubble.addView(av, alp)
            bubble.addView(col)
            lp = ViewGroup.MarginLayoutParams(-2, -2)
            lp.leftMargin = random.randint(24, max(w - 480, 24))
            lp.topMargin = random.randint(int(h * 0.12), int(h * 0.65))

            def add():
                try:
                    target.addView(bubble, lp)
                except Exception:
                    pass

            def rm():
                try:
                    target.removeView(bubble)
                except Exception:
                    pass

            run_on_ui_thread(add)
            threading.Timer(random.uniform(2.8, 5.0), lambda: run_on_ui_thread(rm)).start()
        except Exception as e:
            _slog("fake msg: %s" % e)

    # ── camera / notify / call ──

    def _fx_sys_notify(self):
        try:
            titles = ["Камера", "Микрофон", "МОРГ", "Неизвестный", "Система", "Доступ", "Запись"]
            bodies = [
                "Камера была включена", "Микрофон активен 00:03", "Кто-то поблизости",
                "Новое лицо в кадре", "Запись экрана началась", "Неизвестный вход",
                "МОРГ получил доступ к камере", "Геолокация передана",
                random.choice(WHISPERS),
            ]
            title, body = random.choice(titles), random.choice(bodies)
            try:
                BulletinHelper.show_error("%s: %s" % (title, body))
            except Exception:
                pass
            act, _ = self._root()
            if act is None:
                return
            try:
                from android.app import Notification, NotificationManager, NotificationChannel
                nm = act.getSystemService(Context.NOTIFICATION_SERVICE)
                channel_id = "morgue_horror"
                if Build.VERSION.SDK_INT >= 26:
                    ch = NotificationChannel(channel_id, "МОРГ", NotificationManager.IMPORTANCE_HIGH)
                    nm.createNotificationChannel(ch)
                    builder = Notification.Builder(act, channel_id)
                else:
                    builder = Notification.Builder(act)
                builder.setContentTitle(title)
                builder.setContentText(body)
                builder.setSmallIcon(act.getApplicationInfo().icon)
                builder.setAutoCancel(True)
                try:
                    builder.setPriority(Notification.PRIORITY_HIGH)
                except Exception:
                    pass
                nm.notify(random.randint(90000, 99999), builder.build())
            except Exception as e:
                _slog("notify sys: %s" % e)
        except Exception as e:
            _slog("notify: %s" % e)

    def _fx_echo_notify(self):
        try:
            msg = random.choice(WHISPERS)
            BulletinHelper.show_info(msg)
            threading.Timer(
                0.55,
                lambda: run_on_ui_thread(lambda: BulletinHelper.show_error("…%s" % msg)),
            ).start()
            if self.get_setting("fx_sound", True) and random.random() < 0.5:
                threading.Timer(0.5, lambda: run_on_ui_thread(self._fx_sound)).start()
        except Exception as e:
            _slog("echo: %s" % e)

    def _fx_open_camera(self):
        try:
            act, _ = self._root()
            if act is None:
                return
            intent = Intent(MediaStore.ACTION_IMAGE_CAPTURE)
            try:
                intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            except Exception:
                pass
            act.startActivity(intent)
            if self.get_setting("fx_front_hint", True):
                threading.Timer(0.4, lambda: run_on_ui_thread(self._fx_lens_banner)).start()
            if self.get_setting("fx_sound", True):
                threading.Timer(0.1, lambda: run_on_ui_thread(self._fx_sound)).start()
        except Exception as e:
            _slog("camera: %s" % e)
            try:
                BulletinHelper.show_error("камера открыта · не смотри")
            except Exception:
                pass

