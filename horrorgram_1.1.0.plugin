                except Exception:
                    pass

            run_on_ui_thread(add)
            threading.Timer(random.uniform(1.0, 2.8), lambda: run_on_ui_thread(rm)).start()
        except Exception as e:
            _slog("blood: %s" % e)

    def _fx_swap_names(self):
        try:
            frag = get_last_fragment()
            if frag is None:
                return
            ab = self._action_bar(frag)
            if ab is None:
                return
            scary = random.choice(FAKE_NAMES)
            sub = random.choice([
                "был(а) только что… или нет", "в сети ☠️", "печатает чужими руками",
                "1 участник (ложное)", "онлайн · запись", "смотрит на тебя",
            ])
            old_title = old_sub = None
            try:
                old_title = str(ab.getTitle()) if ab.getTitle() else None
            except Exception:
                pass
            try:
                old_sub = str(ab.getSubtitle()) if ab.getSubtitle() else None
            except Exception:
                pass
            mixed = scary
            if old_title:
                style = random.choice([
                    "{orig} / {bad}", "{bad} ({orig})", "{orig} · {bad}",
                    "{bad} — это {orig}?", "{orig}… нет, {bad}",
                ])
                mixed = style.format(orig=old_title, bad=scary)
            try:
                ab.setTitle(mixed)
            except Exception:
                pass
            try:
                ab.setSubtitle(sub if not old_sub else "%s / %s" % (old_sub, sub))
            except Exception:
                pass
            hold = random.uniform(5.0, 12.0)

            def restore():
                try:
                    if old_title is not None:
                        ab.setTitle(old_title)
                    if old_sub is not None:
                        ab.setSubtitle(old_sub)
                except Exception:
                    pass

            threading.Timer(hold, lambda: run_on_ui_thread(restore)).start()
        except Exception as e:
            _slog("names: %s" % e)

