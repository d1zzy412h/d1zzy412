            def rm():
                try:
                    target.removeView(tv)
                except Exception:
                    pass

            run_on_ui_thread(add)
            threading.Timer(random.uniform(1.5, 4.0), lambda: run_on_ui_thread(rm)).start()
        except Exception as e:
            _slog("react: %s" % e)

